<%# app/templates/books/_form.html.erb -- locals: book (may be nil), routes, submit_label.
    Built with `tag` because Hanami's form_for yields hyphenated ids, but the
    system specs target #book_title / #book_author. Create posts to the
    collection; update posts to the member with a hidden _method=patch, which
    Hanami's method-override middleware (method_override: true) rewrites to PATCH. %>
<%
  editing = !!(book && book.id)
  action = editing ? routes.path(:book, id: book.id) : routes.path(:books)
  title_value = book&.title.to_s
  author_value = book&.author.to_s
-%>
<form action="<%= action %>" method="post">
    <input type="hidden" name="_method" value="<%= "patch" if editing %>">
      <div>
        <label for="book_author" style="display: block">Author</label>
        <%= tag.input(type: "text", id: "book_author", name: "book[author]", value: author_value) %>
      </div>

      <div>
        <label for="book_title" style="display: block">Title</label>
        <%= tag.input(type: "text", id: "book_title", name: "book[title]", value: title_value) %>
      </div>

      <div>
        <%= tag.button(submit_label) %>
      </div>
</form>
